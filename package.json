{
  "name": "@ivosabev/helpers",
  "version": "1.0.14",
  "description": "Reusable Helpers",
  "keywords": [
    "ecmascript",
    "helpers",
    "javascript",
    "typescript",
    "utility functions"
  ],
  "homepage": "https://github.com/ivosabev/helpers#readme",
  "bugs": {
    "url": "https://github.com/ivosabev/helpers/issues"
  },
  "license": "MIT",
  "author": "Ivo Sabev (http://ivosabev.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivosabev/helpers.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./*.js"
  },
  "scripts": {
    "build": "npm run validate && rm -rf dist && run-p -l build-js build-dts && scripts/afterBuild.sh",
    "build-js": "esbuild src/**/*.ts --outdir=dist --format=esm --sourcemap --target=es2023",
    "build-dts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --rootDir src --outDir dist",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint",
    "lint-check": "oxlint",
    "release-it": "release-it",
    "release": "scripts/release.sh",
    "typecheck": "tsc",
    "up": "corepack use pnpm@latest && pnpm update --interactive --latest",
    "validate": "run-p -l lint format typecheck",
    "watch": "npm run build && watchman-make -p 'src/**/*' --run 'npm run build'"
  },
  "dependencies": {
    "@web3-storage/multipart-parser": "1.0.0",
    "chardet": "2.2.0",
    "crypto-js": "4.2.0",
    "fuzzysort": "3.1.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "object-hash": "3.0.0",
    "papaparse": "5.5.4",
    "pluralize": "8.0.0",
    "type-fest": "5.8.0",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@graphql-tools/utils": "11.2.0",
    "@ivosabev/config": "4.0.11",
    "@types/crypto-js": "4.2.2",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.2",
    "@types/node": "26.1.0",
    "@types/object-hash": "3.0.6",
    "@types/papaparse": "5.5.2",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.17",
    "@types/validator": "13.15.10",
    "esbuild": "0.28.1",
    "graphql": "17.0.2",
    "graphql-relay": "0.10.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "react": "19.2.7",
    "release-it": "20.2.1",
    "typescript": "rc",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@graphql-tools/utils": "10.x",
    "graphql": "16.x",
    "graphql-relay": "0.10.2",
    "react": "18.x || 19.x",
    "zod": "4.x"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
