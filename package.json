{
  "name": "@ivosabev/helpers",
  "version": "2.0.9",
  "description": "Reusable Helpers",
  "keywords": [
    "ecmascript",
    "helpers",
    "javascript",
    "typescript",
    "utility functions"
  ],
  "homepage": "https://github.com/ivosabev/helpers#readme",
  "bugs": {
    "url": "https://github.com/ivosabev/helpers/issues"
  },
  "license": "MIT",
  "author": "Ivo Sabev (http://ivosabev.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivosabev/helpers.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./*.js"
  },
  "scripts": {
    "build": "npm run validate && rm -rf dist && run-p -l build-js build-dts && scripts/afterBuild.sh",
    "build-js": "esbuild src/**/*.ts --outdir=dist --format=esm --sourcemap --target=es2023",
    "build-dts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --rootDir src --outDir dist",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint",
    "lint-check": "oxlint",
    "release-it": "release-it",
    "release": "scripts/release.sh",
    "typecheck": "tsc",
    "up": "corepack use pnpm@latest && pnpm update --interactive --latest",
    "validate": "run-p -l lint format typecheck",
    "watch": "npm run build && watchman-make -p 'src/**/*' --run 'npm run build'"
  },
  "dependencies": {
    "@web3-storage/multipart-parser": "1.0.0",
    "chardet": "2.2.0",
    "fuzzysort": "4.0.2",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "object-hash": "3.0.0",
    "papaparse": "5.7.0",
    "pluralize": "8.0.0",
    "type-fest": "5.10.0",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@graphql-tools/utils": "12.0.1",
    "@ivosabev/config": "5.0.9",
    "@types/lodash": "4.17.25",
    "@types/luxon": "3.7.5",
    "@types/node": "26.6.2",
    "@types/object-hash": "3.0.6",
    "@types/papaparse": "5.5.2",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.3.0",
    "@types/validator": "13.15.10",
    "esbuild": "0.28.2",
    "graphql": "17.0.2",
    "graphql-relay": "0.10.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "react": "19.3.0",
    "release-it": "21.1.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@graphql-tools/utils": "12.x",
    "graphql": "17.x",
    "graphql-relay": "0.10.2",
    "react": "18.x || 19.x",
    "zod": "4.x"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
